# OpenAI API Key (required for embeddings and RAG)
OPENAI_API_KEY=your_openai_api_key_here

# Data directories
CHROMA_PERSIST_DIR=../data/chroma
UPLOAD_DIR=../data/uploads
DATABASE_URL=sqlite:///../data/chunk.db

# Chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# File upload limits
MAX_FILE_SIZE_MB=50
